# =============================================================================
# ARCHstudio Server — multi-stage Docker image
#
# Build:
#   docker buildx build -f Dockerfile.server -t archstudio-server .
#
# Run (use --user to match host UID/GID for volume permissions):
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/archstudio \
#     -e ARCHSTUDIO_SERVER_TOKEN=<secret> \
#     archstudio-server
#
# Run with TLS + mounted config:
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/archstudio \
#     -e ARCHSTUDIO_SERVER_TOKEN=<secret> \
#     -e ARCHSTUDIO_RPC_TLS_CERT=/certs/cert.pem \
#     -e ARCHSTUDIO_RPC_TLS_KEY=/certs/key.pem \
#     -v /path/to/certs:/certs:ro \
#     -v ~/.archstudio:/home/archstudio/.archstudio \
#     archstudio-server
# =============================================================================

# =============================================================================
# STAGE 1: builder — compile + bundle everything
# =============================================================================

FROM oven/bun:1.3-slim AS builder

LABEL org.opencontainers.image.source="https://github.com/lukilabs/craft-agents-oss"
LABEL org.opencontainers.image.description="ARCHstudio Server — headless AI workflow server"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install system build deps + Node.js (required by the WhatsApp worker subprocess;
# Bun cannot run Baileys' crypto deps). Pin Node to a major via NodeSource so
# upgrades are explicit — must match the --target in scripts/build-wa-worker.ts.
ARG NODE_MAJOR=20
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git ripgrep curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Layer 1: dependency manifests (rarely changes → cached) ───────────────
# `bunfig.toml` MUST be in WORKDIR before `bun install` runs — it forces
# `linker = "hoisted"`, required for the Vite build (transitive deps resolve
# at top-level node_modules). Without it Bun defaults to isolated installs
# and the build fails on the first transitive bare-package import.
COPY package.json bun.lock bunfig.toml ./
COPY packages/server/package.json packages/server/
COPY packages/server-core/package.json packages/server-core/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/session-mcp-server/package.json packages/session-mcp-server/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/craft-agents-commands/package.json packages/craft-agents-commands/
COPY packages/craft-cli/package.json packages/craft-cli/
COPY packages/ui/package.json packages/ui/
COPY packages/messaging-gateway/package.json packages/messaging-gateway/
COPY packages/messaging-whatsapp-worker/package.json packages/messaging-whatsapp-worker/
COPY apps/electron/package.json apps/electron/
COPY apps/cli/package.json apps/cli/
COPY apps/marketing/package.json apps/marketing/
COPY apps/viewer/package.json apps/viewer/
COPY apps/webui/package.json apps/webui/

RUN bun install --frozen-lockfile

# ── Layer 2: source code (changes frequently → after deps) ───────────────
COPY . .

# ── Layer 3: build MCP helper servers (bundled CJS) ──────────────────────
RUN bun build packages/session-mcp-server/src/index.ts \
      --outfile packages/session-mcp-server/dist/index.js --target node --format cjs && \
    bun build packages/pi-agent-server/src/index.ts \
      --outfile packages/pi-agent-server/dist/index.js --target node --format cjs

# ── Layer 4: build the WhatsApp worker bundle (CJS, Node target) ─────────
RUN bun run scripts/build-wa-worker.ts

# ── Layer 5: build web UI assets ─────────────────────────────────────────
# Vite runs under Node and hits V8's default ~2GB heap cap on the rendering
# phase (>5k modules). Raise to 4GB so low-RAM build hosts can complete.
RUN NODE_OPTIONS="--max-old-space-size=4096" bunx vite build --config apps/webui/vite.config.ts

# =============================================================================
# STAGE 2: runtime — minimal image with only what's needed to run
# =============================================================================

FROM oven/bun:1.3-slim

LABEL org.opencontainers.image.source="https://github.com/lukilabs/craft-agents-oss"
LABEL org.opencontainers.image.description="ARCHstudio Server — headless AI workflow server"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install only runtime system deps.
# curl/gnupg are build-time only — omitted from the final image.
# git + ripgrep are needed at runtime by the agent for file operations.
# nodejs is needed at runtime by the WhatsApp worker subprocess.
ARG NODE_MAJOR=20
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git ripgrep curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    # Remove build-time-only tools: curl and gnupg were only needed for
    # the NodeSource setup. apt-get --auto-remove cleans both.
    apt-get remove -y curl gnupg && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user (Claude Code SDK refuses to run as root).
# At runtime, override with --user $(id -u):$(id -g) to match host permissions.
RUN groupadd -r archstudio && \
    useradd -r -g archstudio -m -d /home/archstudio -s /bin/bash archstudio

WORKDIR /app

# ── Copy built artifacts from builder ─────────────────────────────────────

# node_modules: full dependency tree (hoisted layout)
COPY --from=builder /app/node_modules ./node_modules

# Package sources (only the built/served directories, not source)
COPY --from=builder /app/packages/server ./packages/server
COPY --from=builder /app/packages/server-core ./packages/server-core
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/core ./packages/core
COPY --from=builder /app/packages/session-tools-core ./packages/session-tools-core
COPY --from=builder /app/packages/pi-agent-server ./packages/pi-agent-server
COPY --from=builder /app/packages/craft-agents-commands ./packages/craft-agents-commands
COPY --from=builder /app/packages/craft-cli ./packages/craft-cli
COPY --from=builder /app/packages/ui ./packages/ui

# MCP helper server dist outputs
COPY --from=builder /app/packages/session-mcp-server/dist ./packages/session-mcp-server/dist
COPY --from=builder /app/packages/pi-agent-server/dist ./packages/pi-agent-server/dist

# WhatsApp worker bundle
COPY --from=builder /app/packages/messaging-whatsapp-worker ./packages/messaging-whatsapp-worker

# Messaging gateway (runtime dependency)
COPY --from=builder /app/packages/messaging-gateway ./packages/messaging-gateway

# Built web UI assets (served on the RPC port)
COPY --from=builder /app/apps/webui ./apps/webui

# Electron static resources (docs, release notes — served by the server)
COPY --from=builder /app/apps/electron/resources ./apps/electron/resources

# Top-level scripts (build-wa-worker generates the wa worker from here)
COPY --from=builder /app/scripts ./scripts

# Package root files (only what's needed at runtime)
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/bunfig.toml ./bunfig.toml

# Pre-create .archstudio so Docker named volumes inherit the correct permissions.
RUN mkdir -p /home/archstudio/.archstudio

# Make app world-readable so any --user can run it.
# Use find to only touch files/dirs missing the read bit — much faster than
# chmod -R on the entire tree (node_modules alone has hundreds of thousands).
RUN find /app -not -perm -o=r -exec chmod o+r {} + && \
    find /app -type d -not -perm -o=x -exec chmod o+x {} + && \
    chmod -R 777 /home/archstudio

USER archstudio

ENV NODE_ENV=production
ENV ARCHSTUDIO_RPC_HOST=0.0.0.0
ENV ARCHSTUDIO_RPC_PORT=9100
ENV ARCHSTUDIO_WEBUI_DIR=/app/apps/webui/dist
ENV ARCHSTUDIO_BUNDLED_ASSETS_ROOT=/app/apps/electron
# WhatsApp worker — Bun cannot run the CJS worker, so we point the adapter at
# system `node`. If ARCHSTUDIO_BUNDLED_ASSETS_ROOT changes, update
# ARCHSTUDIO_MESSAGING_WA_WORKER to match; the default in packages/server resolves
# against ARCHSTUDIO_BUNDLED_ASSETS_ROOT, but the layout above flattens to /app.
ENV ARCHSTUDIO_MESSAGING_WA_WORKER=/app/packages/messaging-whatsapp-worker/dist/worker.cjs
ENV ARCHSTUDIO_MESSAGING_NODE_BIN=node

EXPOSE 9100

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:9100/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["bun", "run", "packages/server/src/index.ts"
