# SSH keys and secrets
*.pem
*.key
sshkey
id_rsa*
id_ed25519*

# Credentials files
credentials.enc
*.credentials

# act (local GitHub Actions runner)
.secrets
.actrc

# Local agent/tooling scratch state (databases, logs, downloaded binaries).
# Nothing here is reproducible or reviewable — it must not be committed.
.abacusai/
.freebuff/
.tmp-tools/

# Stray driver/tooling logs that land in the repo root on Windows
NVIDIA Corporation/


# Built subprocess bundles, staged by electron:build:subprocess-servers.
# Regenerated on every electron:build; bridge-mcp-server is committed instead.
apps/electron/resources/pi-agent-server/
apps/electron/resources/session-mcp-server/

# Packaged Electron build output (electron-builder). Never reviewable.
apps/electron/release/
ARCHstudioTEST/

# Dev-server log written by electron:dev
dev.log
