{
  "name": "@craft-agent/eval",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "description": "Phoenix-backed eval runner for Craft Agent real agent workflows",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
